    # --- APERTURE, TOP FACE ----------------------------------------------
    # The triangle star of vertex 102 (station 10, perimeter 2),
    # listed as six ids: 182 183 184 203 204 205. Removing them also removes vertex 102
    # itself - it has no other user - so there is no
    # `delete_vertex index=102` line here, and adding one is a
    # compile error.
    delete_triangle index=182
    delete_triangle index=183
    delete_triangle index=184
    delete_triangle index=203
    delete_triangle index=204
    delete_triangle index=205

    # --- APERTURE, BOTTOM FACE -------------------------------------------
    # The same cut, one line. Vertex 107 is station 10, perimeter 7
    # - the point interior to the matching patch on the b = -3
    # face - and its star is the six triangles 192 193 194 213 214 215.
    delete_vertex index=107

    # --- SHAPE THE TWO OPENINGS ------------------------------------------
    # Six rim vertices per face, moved off the sheared grid hexagon
    # onto a symmetric one 60 long x 32 wide. `du` is arc offset
    # from station 10 along the centreline, `a` is offset across
    # the band. Both faces land on the SAME (du, a) hexagon, which
    # is what makes the bore below a straight prism. Top rim ids run
    # 112 113 103 92 91 101 round the loop; the bottom rim is
    # 117 118 108 97 96 106, and it walks the hexagon in the opposite
    # direction - see the header.
    set_vertex_position index=112 position=(-29.481, 175.247, 1.937)   # top rim -> hexagon 0  du=+30 a=+0
    set_vertex_position index=113 position=(-15.701, 187.97, 13.806)   # top rim -> hexagon 1  du=+15 a=+16
    set_vertex_position index=103 position=(15.794, 189.086, 13.04)   # top rim -> hexagon 2  du=-15 a=+16
    set_vertex_position index=92 position=(29.54, 175.595, 2.291)   # top rim -> hexagon 3  du=-30 a=+0
    set_vertex_position index=91 position=(13.833, 165.617, -8.625)   # top rim -> hexagon 4  du=-15 a=-16
    set_vertex_position index=101 position=(-13.897, 166.38, -9.744)   # top rim -> hexagon 5  du=+15 a=-16
    set_vertex_position index=117 position=(-30.241, 179.765, -1.937)   # bottom rim -> hexagon 0  du=+30 a=+0
    set_vertex_position index=118 position=(-14.265, 170.781, -13.806)   # bottom rim -> hexagon 5  du=+15 a=-16
    set_vertex_position index=108 position=(14.172, 169.665, -13.04)   # bottom rim -> hexagon 4  du=-15 a=-16
    set_vertex_position index=97 position=(30.183, 179.416, -2.291)   # bottom rim -> hexagon 3  du=-30 a=+0
    set_vertex_position index=96 position=(16.132, 193.134, 8.625)   # bottom rim -> hexagon 2  du=-15 a=+16
    set_vertex_position index=106 position=(-16.068, 192.371, 9.744)   # bottom rim -> hexagon 1  du=+15 a=+16

    # --- BORE WALL -------------------------------------------------------
    # Six quads, twelve triangles, top rim to bottom rim. Positions,
    # not ids: these 36 coordinates are copies of the 12 rim
    # positions written above and must stay copies. Wound so the
    # wall is visible from inside the slot. These twelve lines
    # raise no diagnostic at all - see the header.
    append_triangle v0=(-29.481, 175.247, 1.937) v1=(-15.701, 187.97, 13.806) v2=(-16.068, 192.371, 9.744)
    append_triangle v0=(-29.481, 175.247, 1.937) v1=(-16.068, 192.371, 9.744) v2=(-30.241, 179.765, -1.937)
    append_triangle v0=(-15.701, 187.97, 13.806) v1=(15.794, 189.086, 13.04) v2=(16.132, 193.134, 8.625)
    append_triangle v0=(-15.701, 187.97, 13.806) v1=(16.132, 193.134, 8.625) v2=(-16.068, 192.371, 9.744)
    append_triangle v0=(15.794, 189.086, 13.04) v1=(29.54, 175.595, 2.291) v2=(30.183, 179.416, -2.291)
    append_triangle v0=(15.794, 189.086, 13.04) v1=(30.183, 179.416, -2.291) v2=(16.132, 193.134, 8.625)
    append_triangle v0=(29.54, 175.595, 2.291) v1=(13.833, 165.617, -8.625) v2=(14.172, 169.665, -13.04)
    append_triangle v0=(29.54, 175.595, 2.291) v1=(14.172, 169.665, -13.04) v2=(30.183, 179.416, -2.291)
    append_triangle v0=(13.833, 165.617, -8.625) v1=(-13.897, 166.38, -9.744) v2=(-14.265, 170.781, -13.806)
    append_triangle v0=(13.833, 165.617, -8.625) v1=(-14.265, 170.781, -13.806) v2=(14.172, 169.665, -13.04)
    append_triangle v0=(-13.897, 166.38, -9.744) v1=(-29.481, 175.247, 1.937) v2=(-30.241, 179.765, -1.937)
    append_triangle v0=(-13.897, 166.38, -9.744) v1=(-30.241, 179.765, -1.937) v2=(-14.265, 170.781, -13.806)

    # `append_triangle` left 36 duplicate vertices sitting on the
    # two rims; this stitches them. The default tolerance (0.0001)
    # is enough because the wall's coordinates are the same
    # 3-decimal text as the rim's and parse to the same doubles -
    # not because they are merely close.
    weld_vertices

    # 40 degrees keeps the ring smooth (9 degrees between stations)
    # while the four corner rails and both bore rims (90 degrees)
    # stay hard.
    split_normals split_angle=40

    # Cast bronze. One value for the whole band - see the
    # materials block.
    set_vertex_color set_all=true color=(0.45, 0.33, 0.20, 1)

    # Runs LAST, over the appended triangles too. See the header on
    # why the buffer above deliberately ships with no `uvs=`.
    uv channel=0 mode=cylindrical
}

